{
  "extends": "@mtg/config/tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    // src/utils/colorIdentity.mjs is shared with the build script, which runs
    // under bare node and can't read .ts. Its JSDoc types are checked here.
    "allowJs": true,
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
