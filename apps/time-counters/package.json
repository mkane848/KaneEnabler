{
  "name": "mtg-time-tracker",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-catalog.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-catalog.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "fetch-cards": "node scripts/fetch-card-data.mjs",
    "gen-glyphs": "node scripts/gen-mana-glyphs.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@mtg/config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "globals": "^15.14.0",
    "jsdom": "catalog:",
    "mana-font": "1.18.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
