{
  "name": "mtg-time-tracker",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-catalog.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-catalog.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "fetch-cards": "node scripts/fetch-card-data.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mtg/mana": "workspace:*",
    "@mtg/profile": "workspace:*",
    "@mtg/rules": "workspace:*",
    "@mtg/ui": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@mtg/card-model": "workspace:*",
    "@mtg/config": "workspace:*",
    "@mtg/scryfall": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "globals": "^15.14.0",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
