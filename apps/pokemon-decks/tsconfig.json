{
  "extends": "@mtg/config/tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    // Only the test helpers (src/test/) touch Node; the app itself is browser code.
    "types": ["node", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
