# Leave blank for local dev (Vite proxies /api to http://localhost:4000, see vite.config.ts).
# In production, set this to your deployed backend's URL, e.g.:
# VITE_API_URL=https://mtg-recommender-server.onrender.com
VITE_API_URL=

# Optional — powers sign-in and profile features (liked/disliked cards, jank
# tags, favourite combos). Leave both blank to run without profiles; the
# recommender itself needs neither. Get these from your Supabase project's
# API settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
