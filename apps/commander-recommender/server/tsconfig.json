{
  "extends": "@mtg/config/tsconfig.base.json",
  "compilerOptions": {
    // node16 rather than the old CommonJS/Node pair: moduleResolution "node10"
    // was deprecated in TypeScript 6 and is gone in 7. This still emits
    // CommonJS, because server/package.json has no "type": "module" — which
    // is what the handoff's "CommonJS, not ESM" decision was about, and that
    // is unchanged.
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true
  },
  "include": ["src", "scripts"]
}
